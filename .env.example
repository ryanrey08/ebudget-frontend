# ─────────────────────────────────────────────────────────────────────────────
# eBudget frontend configuration. Copy to .env.local and adjust.
#
# Every NEXT_PUBLIC_* value is inlined into the browser bundle at build time and
# is visible to anyone using the app. Only put PUBLIC, non-sensitive settings
# here: never API keys, database credentials, tokens or other secrets.
# Restart `npm run dev` (or rebuild) after changing these values.
# ─────────────────────────────────────────────────────────────────────────────

# Data source: "mock" (in-browser mock API with dummy data, no backend needed)
# or "real" (requests go to NEXT_PUBLIC_API_BASE_URL). Defaults to mock.
NEXT_PUBLIC_API_MODE=mock

# Base URL of the eBudget backend API, no trailing slash. Used in real mode.
# e.g. https://your-backend-domain.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Real mode: request timeout in milliseconds (default 30000).
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# Real mode: send cookies with API requests (needed for the httpOnly session
# cookie; the backend must allow credentials in CORS). Default true.
NEXT_PUBLIC_API_WITH_CREDENTIALS=true

# Mock mode: simulated network latency in milliseconds (default 450).
NEXT_PUBLIC_MOCK_API_DELAY_MS=450

# Mock mode: share of requests (0–1) that fail with a simulated 503, for
# testing error states. Default 0.
NEXT_PUBLIC_MOCK_API_FAILURE_RATE=0

# Mock mode: keep changes to mock data in localStorage across page reloads.
# Default false (data resets on reload).
NEXT_PUBLIC_MOCK_API_PERSIST=false
