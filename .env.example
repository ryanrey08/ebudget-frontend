# Base URL of the eBudget backend API (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# "true" serves every request from the in-browser mock API (src/mocks).
# Set to "false" once the backend is available.
NEXT_PUBLIC_USE_MOCK_API=true

# Simulated network latency for the mock API, in milliseconds.
NEXT_PUBLIC_MOCK_API_DELAY_MS=450
