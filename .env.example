# ─────────────────────────────────────────────────────────────────────────────
# eBudget frontend configuration. Copy to .env.local and adjust.
#
# Every NEXT_PUBLIC_* value is inlined into the browser bundle at build time and
# is visible to anyone using the app. Only put PUBLIC, non-sensitive settings
# here: never API keys, database credentials, tokens or other secrets.
# Restart `npm run dev` (or rebuild) after changing these values.
# ─────────────────────────────────────────────────────────────────────────────

# Data source: "mock" (in-browser mock API with dummy data, no backend needed)
# or "real" (the backend's eBudget data API). Defaults to mock.
#
# In real mode the BROWSER NEVER CALLS THE BACKEND DIRECTLY. It sends data
# requests to this app's own /api/v1/* (the Next.js data proxy in
# src/app/api/v1) and sign-in to /api/auth/*. Those route handlers call
# BACKEND_API_URL from the server with the bearer token from the httpOnly
# session cookie, so the backend needs no CORS, no public address and no
# HTTPS of its own.
NEXT_PUBLIC_API_MODE=mock

# Authentication source: "real" (the backend's /api/v1/{system}/auth/* through
# the same-origin Next.js auth proxy in src/app/api/auth) or "mock" (demo
# accounts). Defaults to NEXT_PUBLIC_API_MODE. "real" works together with
# NEXT_PUBLIC_API_MODE=mock while the backend has no eBudget data endpoints.
NEXT_PUBLIC_AUTH_MODE=real

# Optional, rarely needed: same-origin PATH the browser sends real-mode data
# requests to (default /api/v1, the data proxy). Only a path is accepted; a
# full URL such as https://api.example.gov.ph is ignored with a warning. Put
# the backend's address in the server-only BACKEND_API_URL instead.
# NEXT_PUBLIC_API_BASE_URL=/api/v1

# Real mode: request timeout in milliseconds (default 30000).
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# Mock mode: simulated network latency in milliseconds (default 150).
NEXT_PUBLIC_MOCK_API_DELAY_MS=150

# Mock mode: share of requests (0–1) that fail with a simulated 503, for
# testing error states. Default 0.
NEXT_PUBLIC_MOCK_API_FAILURE_RATE=0

# Mock mode: keep changes to mock data in localStorage across page reloads.
# Default false (data resets on reload).
NEXT_PUBLIC_MOCK_API_PERSIST=false

# ── Server-only settings (no NEXT_PUBLIC_ prefix: never sent to the browser) ──
# Read by the auth proxy (src/app/api/auth/*) and the data proxy
# (src/app/api/v1/*), which call the backend on the server and keep its bearer
# token in an httpOnly cookie. Only the Next.js server needs to reach this
# address, so it can be a private-network one (e.g. http://10.15.0.14/api/v1).

# Versioned backend API root, no trailing slash (the backend's nginx listens on
# APP_PORT, 8080 by default; routes are /api/v1/{system}/...). The data proxy
# maps /api/v1/<path> to {BACKEND_API_URL}/{BACKEND_SYSTEM}/<path>.
BACKEND_API_URL=http://localhost:8080/api/v1

# Which backend system this frontend signs in to: ebudget | engas | sims.
BACKEND_SYSTEM=ebudget

# Timeout for proxy → backend requests, in milliseconds (default 15000).
BACKEND_TIMEOUT_MS=15000

# Set to "true" only to test a production build over plain http (drops the
# Secure flag from the session cookie). Never in a real deployment.
SESSION_COOKIE_INSECURE=false

# ── Docker (docker-compose*.yml) ─────────────────────────────────────────────
# Compose does not read .env.local. Defaults in the compose files work out of
# the box on macOS; to change them, copy the lines you need into a file such as
# .env.docker (git-ignored) and pass it with:
#   docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# See docker/README.md for details.
#
# Inside a container "localhost" is the container itself, not your Mac:
#   - Server-only BACKEND_API_URL (used by the container) must reach the backend
#     from INSIDE the container, e.g. http://host.docker.internal:8080/api/v1
#     when the backend is published on the host's port 8080.
#   - The browser only talks to the frontend itself (/api/v1/*, /api/auth/*),
#     so no backend address is compiled into the bundle.
#   - NEXT_PUBLIC_* values are compiled into the production image: rebuild
#     after changing them. Server-only values only need a container restart.
#
# FRONTEND_PORT=3000                 # host port mapped to the container's 3000
# FRONTEND_IMAGE=ebudget-frontend:latest
# BACKEND_API_URL=http://host.docker.internal:8080/api/v1
# WATCHPACK_POLLING=false            # dev only: "true" if hot reload misses edits
